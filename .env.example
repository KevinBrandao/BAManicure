# ============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local.
# ============================================================================

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Produção: connection string do PostgreSQL (Supabase).
#   Supabase → Connect → Connection string → "Transaction pooler" (porta 6543).
#   Formato: postgresql://postgres.<ref-do-projeto>:<SENHA>@<host-do-pooler>:6543/postgres
#   Se a senha tiver caracteres especiais, codifique-os (ex.: @ vira %40, # vira %23).
# Esta é a ÚNICA variável de banco necessária: o projeto usa o driver pg com SQL
# direto (sem Prisma e sem supabase-js), então DIRECT_URL, NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY NÃO são usadas.
# Se ficar VAZIA, o sistema usa um PostgreSQL embutido (PGlite) em ./.data/pglite —
# somente para desenvolvimento local. Em produção, vazia = erro.
DATABASE_URL=

# TLS fica sempre ligado. Defina "false" apenas para um Postgres local sem TLS.
DATABASE_SSL=true

# Conexões por instância (opcional; padrão 3). O pooler do Supabase multiplexa o resto.
# DATABASE_POOL_MAX=3

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# URL pública do site (usada em SEO, sitemap e links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Administradora inicial (usado apenas por `npm run admin:create`)
# ---------------------------------------------------------------------------
ADMIN_NAME=
ADMIN_EMAIL=
# Mínimo de 10 caracteres.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)  — veja docs/WHATSAPP.md
# ---------------------------------------------------------------------------
# Token de acesso permanente (System User) com as permissões
# whatsapp_business_messaging e whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone (Phone Number ID) — NÃO é o número em si.
WHATSAPP_PHONE_NUMBER_ID=
# App Secret do aplicativo Meta (valida a assinatura dos webhooks).
WHATSAPP_APP_SECRET=
# Texto livre escolhido por você; o mesmo valor é informado no painel da Meta
# ao cadastrar o webhook.
WHATSAPP_VERIFY_TOKEN=
# Versão da Graph API. Confira a versão vigente no painel da Meta.
WHATSAPP_GRAPH_VERSION=v23.0

# Templates aprovados para lembretes fora da janela de 24 horas.
# Informe o NOME exato de cada template aprovado na Meta.
WHATSAPP_TEMPLATE_LEMBRETE_1H=
WHATSAPP_TEMPLATE_LEMBRETE_30MIN=
WHATSAPP_TEMPLATE_LEMBRETE_10MIN=
WHATSAPP_TEMPLATE_LANG=pt_BR

# ---------------------------------------------------------------------------
# Lembretes automáticos
# ---------------------------------------------------------------------------
# Segredo exigido pelo endpoint /api/cron/lembretes
# (cabeçalho "Authorization: Bearer <CRON_SECRET>").
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
